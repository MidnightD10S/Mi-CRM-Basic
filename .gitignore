# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# railway
.railway

# convex
.convex

# typescript
*.tsbuildinfo
next-env.d.ts

# credenciales locales (MID-7, MID-25): nunca deben subirse ni commitearse
*.local.txt
*.local.json

# playwright (MID-25): artefactos de cada corrida, no el código de la suite
/test-results/
/playwright-report/
/blob-report/

# MID-25: scratch de Convex con borrado amplio — ad-hoc, nunca se commitea
# (ver tests/e2e/README.md). Red de seguridad por si un `git add` amplio lo
# agarra sin querer — la disciplina real sigue siendo no commitearlo nunca.
convex/_scratch*.ts
